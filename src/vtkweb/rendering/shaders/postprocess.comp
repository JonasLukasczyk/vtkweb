#version 450
// Prototype compute shader contract: persistent full-frame color/depth images,
// one dispatch per presentation frame. SSAO and post-process DOF are intentionally
// fused to avoid extra copies; physical DOF arrives pre-resolved from Mitsuba.
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0, rgba8) uniform readonly image2D colorIn;
layout(binding=1, r32f) uniform readonly image2D depthIn;
layout(binding=2, rgba8) uniform writeonly image2D colorOut;
layout(push_constant) uniform Params { int ssaoSlices; int ssaoSteps; float ssaoRadius; float ssaoStrength; float ssaoThickness; int dof; float focus; float aperture; float fov; } p;
void main() {
  ivec2 q=ivec2(gl_GlobalInvocationID.xy); ivec2 size=imageSize(colorIn); if(any(greaterThanEqual(q,size))) return;
  vec4 base=imageLoad(colorIn,q); float z=imageLoad(depthIn,q).r; float occ=0.0, count=0.0;
  int dirs=clamp(p.ssaoSlices*2,2,8), steps=clamp(p.ssaoSteps,1,4);
  if(p.ssaoSlices>0 && p.ssaoRadius>0.0 && isfinite(z) && z>0.0) for(int d=0;d<dirs;d++){ float a=3.14159265*float(d)/float(dirs); for(int s=1;s<=steps;s++){ float dist=p.ssaoRadius*pow(float(s)/float(steps),2.0); ivec2 n=q+ivec2(round(cos(a)*dist),round(sin(a)*dist)); if(all(greaterThanEqual(n,ivec2(0)))&&all(lessThan(n,size))){ float nz=imageLoad(depthIn,n).r; if(isfinite(nz)&&nz>0.0){ occ += nz < z-p.ssaoThickness ? 1.0:0.0; count+=1.0; }}}}
  if(count>0.0) base.rgb*=pow(clamp(1.0-occ/count,0.0,1.0),max(0.0,p.ssaoStrength));
  // Variable-radius DOF: bounded 9x9 stochastic-free box approximation. This
  // follows the baseline CoC equation; radius is capped for predictable cost.
  if(p.dof!=0 && p.aperture>0.0 && isfinite(z) && z>0.0){ float focal=0.5*float(size.y)/max(tan(0.5*radians(p.fov)),1e-12); float coc=clamp(p.aperture*focal*abs(1.0/z-1.0/max(p.focus,1e-6)),0.0,32.0); int r=int(min(4.0,ceil(coc/8.0))); if(r>0){ vec3 sum=vec3(0); float n=0; for(int y=-r;y<=r;y++)for(int x=-r;x<=r;x++){ ivec2 s=clamp(q+ivec2(x,y),ivec2(0),size-1); sum+=imageLoad(colorIn,s).rgb;n+=1.0;} base.rgb=mix(base.rgb,sum/n,clamp(coc/32.0,0.0,1.0)); }}
  imageStore(colorOut,q,base);
}
